/* Configurações Gerais e Cores */
:root {
    --bg-dark: #0a0e17;
    --bg-card: #141b2b;
    --primary: #00e5ff;
    --primary-hover: #00b3cc;
    --text-main: #ffffff;
    --text-muted: #8fa0b5;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
}

/* Cabeçalho e Navegação */
.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background-color: rgba(10, 14, 23, 0.95);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #1e293b;
}

.logo h1 {
    font-size: 1.8rem;
    font-weight: 800;
}

.logo h1 span {
    color: var(--primary);
}

nav {
    display: flex;
    align-items: center;
    gap: 30px;
}

nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

nav a:hover {
    color: var(--white);
}

.btn-nav {
    background-color: var(--primary);
    color: var(--bg-dark) !important;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
}

.btn-nav:hover {
    background-color: var(--primary-hover);
}

/* Seções Gerais */
section {
    padding: 80px 8%;
    max-width: 1200px;
    margin: 0 auto;
}

/* Hero Section */
.hero {
    text-align: center;
    padding: 120px 8%;
    background: radial-gradient(circle at center, #1e293b 0%, var(--bg-dark) 70%);
}

.hero h2 {
    font-size: 3rem;
    margin-bottom: 20px;
    line-height: 1.2;
}

.hero p {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 40px auto;
}

/* Botões Globais */
.btn-primary {
    display: inline-block;
    background-color: var(--primary);
    color: var(--bg-dark);
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s, background 0.3s;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
    transform: translateY(-2px);
}

/* Grid de Recursos (Sobre Nós) */
.sobre h2, .planos h2, .contato h2 {
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 50px;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
}

.feature-card {
    background-color: var(--bg-card);
    padding: 30px;
    border-radius: 12px;
    border: 1px solid #1e293b;
}

.feature-card h3 {
    margin-bottom: 12px;
    color: var(--primary);
}

.feature-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
}

/* Grid de Planos */
.planos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    align-items: center;
}

.plano-card {
    background-color: var(--bg-card);
    padding: 40px 30px;
    border-radius: 16px;
    border: 1px solid #1e293b;
    text-align: center;
    position: relative;
}

.plano-card.destacado {
    border-color: var(--primary);
    transform: scale(1.05);
}

.tag-destaque {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--primary);
    color: var(--bg-dark);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.plano-card h3 {
    font-size: 1.5rem;
    margin-bottom: 15px;
}

.preco {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 30px;
}

.preco span {
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 400;
}

.plano-card ul {
    list-style: none;
    margin-bottom: 35px;
    text-align: left;
}

.plano-card ul li {
    margin-bottom: 12px;
    color: var(--text-muted);
    font-size: 0.95rem;
}

.plano-card ul li::before {
    content: "✓ ";
    color: var(--primary);
    margin-right: 8px;
    font-weight: bold;
}

.btn-card {
    display: block;
    border: 2px solid var(--primary);
    color: var(--primary);
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s, color 0.3s;
}

.btn-card:hover, .btn-card.principal {
    background-color: var(--primary);
    color: var(--bg-dark);
}

.btn-card.principal:hover {
    background-color: var(--primary-hover);
    border-color: var(--primary-hover);
}

/* Seção Contato */
.contato {
    text-align: center;
}

.contato p {
    color: var(--text-muted);
    margin-bottom: 30px;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 40px;
    border-top: 1px solid #1e293b;
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* Responsividade Básica */
@media (max-width: 768px) {
    .header-container {
        flex-direction: column;
        gap: 15px;
    }
    .hero h2 {
        font-size: 2rem;
    }
    .plano-card.destacado {
        transform: none;
    }
}
