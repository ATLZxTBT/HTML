from flask import Flask, render_template


app = Flask(__name__)
@app.route("/")
### Defines route to HTML file

def MainPage():
    PyUsersList = [("Atlas","genwylder@gmail.com",109),
                   ("Hayden","h.harris@gmail.com",89),
                   ("Arion","bh.arion@gmail.com",36),
                   ("Yanaye","eos.official@gmail.com",26),
                   ("Rebbeca","becca.lenner@gmail.com",22)]
    PyMessage = f"Your email is {PyUsersList[0][1]}"
    return render_template("ilum.html", UserName=PyUsersList[1], Message=PyMessage)

if __name__ == "__main__":
    app.run(debug=True, host="0.0.0.0", port=5000)
